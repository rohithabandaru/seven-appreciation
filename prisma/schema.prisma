generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("user") // "user" or "admin"

  accounts Account[]
  sessions Session[]

  posts              Post[]
  followers          Follow[]            @relation("following")
  following          Follow[]            @relation("follower")
  blocks             Block[]             @relation("blocker")
  blockedBy          Block[]             @relation("blocked")
  comments           Comment[]
  savedItems         SavedItem[]
  unlockedPhotocards UnlockedPhotocard[]
  postLikes          PostLike[]

  appreciationLikes  AppreciationLike[]
  photoLikes         PhotoLike[]
  milestoneLikes     MilestoneLike[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Post {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type     String // "story", "achievement", "letter", "reel"
  memberId String? // The enhypen member this relates to (optional for general posts)

  title    String?
  content  String? @db.Text
  mediaUrl String? // For YouTube/Instagram links or image uploads

  status String @default("pending") // "pending", "approved", "rejected"

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  comments  Comment[]
  likes     PostLike[]

  @@index([status])
  @@index([memberId])
  @@index([userId])
}

model Follow {
  followerId  String
  followingId String

  follower  User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([followerId, followingId])
}

model Block {
  blockerId String
  blockedId String

  blocker User @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
}

model AppreciationMessage {
  id         String   @id @default(cuid())
  memberId   String
  memberName String
  userId     String?  @default("user")
  userName   String   @default("Kind Supporter")
  userAvatar String?
  content    String   @db.Text
  status     String             @default("approved")
  likesCount Int                @default(0)
  createdAt  DateTime           @default(now())
  likes      AppreciationLike[]

  @@index([status])
  @@index([memberId])
}

model MemberPhoto {
  id          String   @id @default(cuid())
  memberSlug  String
  url         String   @db.Text
  caption     String?
  category    String   @default("Stage")
  date        String?
  credit      String?     @default("Community Contributor")
  uploadedBy  String?
  likesCount  Int         @default(0)
  createdAt   DateTime    @default(now())
  likes       PhotoLike[]
}

model Letter {
  id          String    @id @default(cuid())
  memberId    String?
  memberName  String?
  userId      String?   @default("user")
  userName    String    @default("Kind Supporter")
  userAvatar  String?
  title       String
  body        String    @db.Text
  imageUrl    String?   @db.Text
  visibility  String    @default("shared")
  sealedUntil DateTime?
  createdAt   DateTime  @default(now())

  @@index([visibility])
  @@index([memberId])
  @@index([userId])
}

model CommunityMilestone {
  id          String   @id @default(cuid())
  memberId    String? // null = "All Seven" / group milestone
  memberName  String? // display name or "All Seven"
  userId      String?  @default("user")
  userName    String   @default("Kind Supporter")
  userAvatar  String?
  title       String
  description String   @db.Text
  eventDate   String // e.g. "2024-07-04"
  category    String   @default("Milestone") // Music, Performance, Milestone, Global Impact, Artistry
  sourceUrl   String? // optional verification link
  likesCount  Int             @default(0)
  status      String          @default("approved") // approved, pending, flagged
  createdAt   DateTime        @default(now())
  likes       MilestoneLike[]
}

model BannedIP {
  id        String   @id @default(cuid())
  ip        String   @unique
  reason    String?
  bannedBy  String? // admin user id
  createdAt DateTime @default(now())
}

model Report {
  id             String   @id @default(cuid())
  reporterId     String?
  reporterIp     String?
  reason         String
  contentType    String
  contentId      String
  contentSnippet String?
  status         String   @default("pending") // "pending", "actioned", "dismissed"
  actionTaken    String?
  createdAt      DateTime @default(now())
  actions        ModerationAction[]
}

model ModerationAction {
  id           String   @id @default(cuid())
  reportId     String
  report       Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  adminId      String
  action       String   // "dismiss", "hide", "remove", "warn_user", "ban_user"
  detail       String?
  createdAt    DateTime @default(now())

  @@index([reportId])
  @@index([adminId])
  @@index([createdAt])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  createdAt DateTime @default(now())
}

model SavedItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemType  String // "post", "appreciation", "photo"
  itemId    String
  createdAt DateTime @default(now())

  @@unique([userId, itemType, itemId])
}

model UnlockedPhotocard {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId    String
  createdAt DateTime @default(now())

  @@unique([userId, cardId])
}

model AppreciationLike {
  id             String              @id @default(cuid())
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  appreciationId String
  appreciation   AppreciationMessage @relation(fields: [appreciationId], references: [id], onDelete: Cascade)
  createdAt      DateTime            @default(now())

  @@unique([userId, appreciationId])
}

model PhotoLike {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  photoId   String
  photo     MemberPhoto @relation(fields: [photoId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([userId, photoId])
}

model MilestoneLike {
  id          String             @id @default(cuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestoneId String
  milestone   CommunityMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  createdAt   DateTime           @default(now())

  @@unique([userId, milestoneId])
}

model PostLike {
  id        String @id @default(cuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
}

model SecurityLog {
  id        String   @id @default(cuid())
  event     String
  ip        String?
  userId    String?
  detail    String?
  endpoint  String?
  createdAt DateTime @default(now())

  @@index([event])
  @@index([ip])
  @@index([createdAt])
}

model UploadedFile {
  id           String   @id @default(cuid())
  ownerId      String
  storageKey   String   @unique
  url          String   @db.Text
  fileData     String?  @db.Text
  originalName String?
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  purpose      String   @default("photo")
  createdAt    DateTime @default(now())

  @@index([ownerId])
  @@index([purpose])
  @@index([createdAt])
}
